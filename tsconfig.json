{
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "Preserve",
    "moduleResolution": "bundler",
    "types": ["node"],
    // The server entry point is a NestJS module. This one declares no
    // provider, but a plugin started from it soon will, and NestJS resolves a
    // provider's constructor arguments from the metadata these two emit. A
    // plugin built without them ships providers whose dependencies cannot be
    // resolved, which fails when the instance loads it rather than here.
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "noEmit": true
  },
  "include": ["src", "test", "vitest.config.ts"]
}
